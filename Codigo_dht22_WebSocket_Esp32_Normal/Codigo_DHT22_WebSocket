// ===============================
// EVENTOS DO WEBSOCKET
// ===============================
void eventoWebSocket(
  uint8_t numeroCliente,
  WStype_t tipo,
  uint8_t* payload,
  size_t tamanho
) {
  if (tipo == WStype_CONNECTED) {
    Serial.print("Cliente WebSocket conectado: ");
    Serial.println(numeroCliente);

    servidorWebSocket.sendTXT(numeroCliente, ultimoJSON);
  }

  if (tipo == WStype_DISCONNECTED) {
    Serial.print("Cliente desconectado: ");
    Serial.println(numeroCliente);
  }
}

// ===============================
// LEITURA DO SENSOR
// ===============================
void lerSensorETransmitir() {
  float umidade = dht.readHumidity();
  float temperatura = dht.readTemperature();

  if (isnan(umidade) || isnan(temperatura)) {
    ultimoJSON = "{\"erro\":true}";
    Serial.println("Falha na leitura do DHT22");
  } else {
    ultimoJSON =
      "{\"temperatura\":" + String(temperatura, 2) +
      ",\"umidade\":" + String(umidade, 2) + "}";

    Serial.print("Temperatura: ");
    Serial.print(temperatura);
    Serial.println(" °C");

    Serial.print("Umidade: ");
    Serial.print(umidade);
    Serial.println(" %");
  }

  servidorWebSocket.broadcastTXT(ultimoJSON);
}

// ===============================
// SETUP
// ===============================
void setup() {
  Serial.begin(115200);

  dht.begin();

  WiFi.begin(WIFI_SSID, WIFI_SENHA);

  Serial.print("Conectando ao Wi-Fi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("Wi-Fi conectado!");
  Serial.print("IP do ESP32: ");
  Serial.println(WiFi.localIP());

  servidorHTTP.on("/", []() {
    servidorHTTP.send(
      200,
      "text/html",
      paginaHTML
    );
  });

  servidorHTTP.begin();

  servidorWebSocket.begin();
  servidorWebSocket.onEvent(eventoWebSocket);

  Serial.println("Servidor HTTP iniciado.");
  Serial.println("Servidor WebSocket iniciado.");
}

// ===============================
// LOOP
// ===============================
void loop() {
  servidorHTTP.handleClient();
  servidorWebSocket.loop();

  if (millis() - ultimaLeitura >= 2000) {
    ultimaLeitura = millis();
    lerSensorETransmitir();
  }
}