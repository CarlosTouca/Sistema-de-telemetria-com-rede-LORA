#include <WiFi.h>
#include <WebServer.h>

//Instalar WebSockets by Markus Sattler
#include <WebSocketsServer.h>
#include "DHT.h"

// ===============================
// WI-FI
// ===============================
const char* WIFI_SSID = "SUA_REDE_AQUI";
const char* WIFI_SENHA = "SUA_SENHA";

// ===============================
// DHT22
// ===============================
#define DHTPIN 26
#define DHTTYPE DHT22

DHT dht(DHTPIN, DHTTYPE);

// ===============================
// SERVIDORES
// ===============================
WebServer servidorHTTP(80);
WebSocketsServer servidorWebSocket(81);

unsigned long ultimaLeitura = 0;
String ultimoJSON = "{\"status\":\"iniciando\"}";

// ===============================
// PÁGINA WEB
// ===============================
const char paginaHTML[] PROGMEM = R"rawliteral(
